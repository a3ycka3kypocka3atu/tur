# Public Supabase configuration. Publishable keys are safe for browser use and
# are constrained by Row Level Security. Never expose a secret/service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep local review deterministic. Switch to supabase only after the Veya
# migration is applied and the dedicated project has been verified.
VEYA_CONTENT_SOURCE=seed

# Existing concierge notification bridge. The URL remains server-only.
APPS_SCRIPT_ENDPOINT=
APPS_SCRIPT_SHARED_SECRET=

# Canonical public origin used by metadata, sitemap, and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
